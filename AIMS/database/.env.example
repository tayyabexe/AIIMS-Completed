# AIMS database tooling — environment template
#
# Copy to `.env` and fill in real values. NEVER commit the .env file.
# Every value below is a placeholder. See docs/DEPLOYMENT.md section 5.2.
#
# WHO READS THIS FILE
# -------------------
#   - sequelize-cli          (db:migrate, db:migrate:status, db:seed)
#   - every script in scripts/  (schema generators, backup, restore,
#     create_ai_readonly_user, create_first_admin, verifiers)
#
# The running API reads a DIFFERENT file: AIMS/backend/.env

# -------------------------------------------------------------- database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aims_db
DB_USER=aims_app
DB_PASSWORD=CHANGE_ME

# true when the server requires TLS. Then put the CA certificate at
# AIMS/database/config/ca.pem. false for a private network.
DB_SSL=false

# ---------------------------------------------------------------------
# ⚠  DB_NAME MUST MATCH AIMS/backend/.env
# ---------------------------------------------------------------------
# These two files drift, and they fail differently. sequelize-cli reads
# THIS one, so if the backend is pointed at a test database while this
# still names production, a bare `npx sequelize-cli db:migrate` runs
# against PRODUCTION DATA.
#
# Check both, every time, before migrating:
#
#     grep DB_NAME AIMS/backend/.env AIMS/database/.env
#
# The generator scripts take an explicit override so you do not have to
# edit this file for a one-off run:
#
#     DB_NAME=aims_db node scripts/generate_schema_from_live.js
# ---------------------------------------------------------------------

# ------------------------------------------ AI read-only database user
# Read by scripts/create_ai_readonly_user.js, which CREATES the account,
# and by prove_readonly_account.js, which proves it cannot write.
# The same pair must also be set in AIMS/backend/.env, which is what the
# running application connects with.
AI_DB_USER=aims_ai_ro
AI_DB_PASSWORD=CHANGE_ME
