# AIMS backend — environment template
#
# Copy to `.env` and fill in real values. NEVER commit the .env file.
# Every value below is a placeholder. See docs/DEPLOYMENT.md section 5.1.

# ---------------------------------------------------------------- server
PORT=5000

# Comma-separated list of origins the browser may load the frontend from.
# Must be EXACT, including scheme and port. A wildcard does not work: the
# browser rejects one on credentialed requests.
#
# Development default (Vite uses 5173, or 5174/5175 if taken):
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# Production example:
# CORS_ORIGIN=https://aims.yourdomain.edu

# -------------------------------------------------------------- database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aims_db
DB_USER=aims_app
DB_PASSWORD=CHANGE_ME

# true when the server requires TLS. Then put the CA at
# AIMS/database/config/ca.pem. false for a private network.
DB_SSL=false

# NOTE: DB_NAME must match AIMS/database/.env, which is what sequelize-cli
# and every database script reads. They drift, and they fail differently:
# a bare `db:migrate` with the wrong value here runs against the wrong
# database. Check both:  grep DB_NAME backend/.env database/.env

# ------------------------------------------------------------------ auth
# Generate each INDEPENDENTLY:  openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRES=8h

# NOTE: the two variables below are read by nothing. No refresh token is
# implemented anywhere in the backend — a session is one access token of
# ACCESS_TOKEN_EXPIRES, then a sign-out. They are left here only so their
# absence is not mistaken for an oversight. See SECURITY.md section 2.2.
JWT_REFRESH_SECRET=CHANGE_ME
REFRESH_TOKEN_EXPIRES=7d

# ------------------------------------------- AI: read-only database user
# The account both AI features read through. SELECT only, with
# column-level restrictions. Create it with:
#   cd AIMS/database && node scripts/create_ai_readonly_user.js
# Then PROVE it cannot write:
#   node scripts/prove_readonly_account.js
# The same pair must also be set in AIMS/database/.env.
AI_DB_USER=aims_ai_ro
AI_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------ AI: model access
# Comma-separated pool, used in rotation so one key hitting a rate limit
# does not stop the service. Get keys at https://console.groq.com
# A single GROQ_API_KEY is also honoured.
GROQ_API_KEYS=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-120b

# Optional per-service overrides. Each falls back to GROQ_MODEL, then to
# the shared default in src/config/groq.js.
# ANALYTICS_MODEL=
# CHATBOT_MODEL=

# Per-account request limits. Admins get 3x these.
ASSISTANT_RATE_PER_MINUTE=8
ASSISTANT_RATE_PER_HOUR=60
ASSISTANT_RATE_PER_DAY=200

# -------------------------------------- AI: vector store (chatbot only)
# Ask the Data does NOT need any of this.
# Start Qdrant with:
#   docker compose -f docker-compose.qdrant.yml up -d
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=aims_knowledge

# Embeddings run locally on CPU — no API call and no cost.
# Changing the model means changing the dimension to match AND
# re-ingesting the whole corpus. See AI_RUNBOOK.md.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Retrieval tuning. NOTE: these two currently have NO EFFECT — a known
# bug means the values fall through to src/config/assistant.js.
# See AI_IMPLEMENTATION.md section 9.
CHATBOT_TOP_K=10
CHATBOT_MIN_SCORE=0.30
