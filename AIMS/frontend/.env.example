# Copy to .env and adjust for your environment.

# Base URL of the AIMS backend (backend/src/server.js listens on PORT=5000).
# Whatever origin the Vite dev server runs on must also be listed in the
# backend's CORS_ORIGIN variable, or the browser will block every request.
VITE_API_BASE_URL=http://localhost:5000

# Request timeout in milliseconds.
VITE_API_TIMEOUT=30000
